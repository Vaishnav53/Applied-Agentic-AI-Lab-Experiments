# ==============================================================================
# Applied Agentic AI Laboratory — Experiment 03 Environment Configuration
# Course Code: MR23-1CS0436
# ==============================================================================

# LLM Provider Configuration
# Supported providers: MOCK | OPENAI | ANTHROPIC | GEMINI
# Default is MOCK for offline / zero-API-key laboratory evaluation
LLM_PROVIDER=MOCK

# Model Names
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-flash

# API Keys (Insert your key if switching provider from MOCK)
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Summarization Preferences
DEFAULT_SUMMARY_STYLE=executive
DEFAULT_SUMMARY_LENGTH=medium

# Application Server Settings
HOST=127.0.0.1
PORT=8002
DEBUG=true
