# ==============================================================================
# Applied Agentic AI Laboratory — Experiment 02 Environment Configuration
# Course Code: MR23-1CS0436
# ==============================================================================

# LLM Provider Configuration
# Supported response providers: MOCK | OPENAI | ANTHROPIC | GEMINI
# Default is MOCK for offline / zero-API-key laboratory evaluation
LLM_PROVIDER=MOCK

# Model Names
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=local-dense-384

# API Keys (Insert your key if switching provider from MOCK)
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# RAG & Chunking Parameters
CHUNK_SIZE=400
CHUNK_OVERLAP=60
DEFAULT_TOP_K=4
RELEVANCE_THRESHOLD=0.25

# Application Server Settings
HOST=127.0.0.1
PORT=8001
DEBUG=true
