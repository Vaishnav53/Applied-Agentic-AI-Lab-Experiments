# ==============================================================================
# Applied Agentic AI Laboratory — .gitignore
# Course Code: MR23-1CS0436
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & Environment Variables (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
*.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
config.secrets.json

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# Node.js & Web Applications
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.nuxt/
.vuepress/
.astro/
.svelte-kit/

# ------------------------------------------------------------------------------
# Databases, Vector Indexes & Local Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
chroma_db/
faiss_index/
vector_store/
*.duckdb
*.parquet

# ------------------------------------------------------------------------------
# IDE, Editors & OS Files
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# Model Checkpoints & Large Assets (Weights / Datasets)
# ------------------------------------------------------------------------------
*.bin
*.onnx
*.pt
*.pth
*.safetensors
*.gguf
/models/
/checkpoints/
/datasets/
/downloads/
!/**/.gitkeep

# ------------------------------------------------------------------------------
# Temporary Files & Logs
# ------------------------------------------------------------------------------
*.log
tmp/
temp/
*.tmp
