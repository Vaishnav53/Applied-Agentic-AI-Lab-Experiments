# Experiment 04 — SQL Agent with Tool Use Configuration

# LLM Provider Selection: "mock" (Offline Demonstration) | "openai" | "anthropic" | "gemini"
LLM_PROVIDER=mock

# External API Keys (Optional - only required if LLM_PROVIDER is set to an API provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Database Configuration
DATABASE_PATH=data/company.db

# Agent Loop Configuration
MAX_AGENT_ITERATIONS=8

# Server Configuration
PORT=8003
HOST=127.0.0.1
